    {
      "name": "report_query",
      "title": "Query analytics report",
      "description": "Query analytics segments or sales/finance report-period CSV/TSV with exact filters, projected rows, finite numeric sums and optional grouping. At most 20 segments, 100 groups, 200 rows and 20KB output. Artifact exports all matching projected rows locally; last 8 retained until eviction/server exit. dateRange selects analytics instance processingDate; sales/finance use reportDate. Numeric sums are finite f64 without financial rounding or semantic inference.",
      "inputSchema": {
        "additionalProperties": false,
        "oneOf": [
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reportId"
                  ]
                },
                {
                  "required": [
                    "report"
                  ]
                }
              ]
            },
            "required": [
              "segmentId"
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "segmentId"
                  ]
                },
                {
                  "required": [
                    "report"
                  ]
                }
              ]
            },
            "required": [
              "reportId"
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "segmentId"
                  ]
                },
                {
                  "required": [
                    "reportId"
                  ]
                }
              ]
            },
            "required": [
              "report",
              "vendorNumber",
              "reportDate"
            ]
          }
        ],
        "properties": {
          "columns": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "type": "array",
            "uniqueItems": true
          },
          "dateRange": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              },
              "to": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "type": "object"
          },
          "filters": {
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "maxProperties": 100,
            "type": "object"
          },
          "frequency": {
            "type": "string"
          },
          "groupBy": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "type": "array",
            "uniqueItems": true
          },
          "limit": {
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "metrics": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "type": "array",
            "uniqueItems": true
          },
          "output": {
            "enum": [
              "summary",
              "rows",
              "artifact"
            ]
          },
          "regionCode": {
            "minLength": 1,
            "type": "string"
          },
          "report": {
            "enum": [
              "sales",
              "finance"
            ]
          },
          "reportDate": {
            "minLength": 1,
            "type": "string"
          },
          "reportId": {
            "minLength": 1,
            "type": "string"
          },
          "reportSubType": {
            "type": "string"
          },
          "reportType": {
            "type": "string"
          },
          "reportVersion": {
            "type": "string"
          },
          "segmentId": {
            "minLength": 1,
            "type": "string"
          },
          "vendorNumber": {
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "annotations": {
        "title": "Query analytics report",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
