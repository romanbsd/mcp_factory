    {
      "name": "app_get",
      "description": "Resolve an app by bundle ID; return compact identity.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bundleId": {
            "minLength": 1,
            "type": "string"
          },
          "platform": {
            "default": "IOS",
            "enum": [
              "IOS",
              "MAC_OS",
              "TV_OS",
              "VISION_OS"
            ],
            "type": "string"
          }
        },
        "required": [
          "bundleId"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "asset_upload",
      "title": "Upload App Store Connect asset",
      "description": "Upload a file to App Store Connect using Apple's asset protocol: reserve, upload byte ranges, commit with an MD5 checksum, then wait for processing. Kinds: app screenshots/previews (parent = screenshot/preview set ID), App Review attachments (parent = appStoreReviewDetail ID), export-compliance documents (parent = appEncryptionDeclaration ID), and subscription/in-app purchase review screenshots (parent = subscription/inAppPurchase ID). `file` is relative to MCP_FACTORY_MEDIA_ROOT. Failures name the stage (validate, reserve, upload, commit, processing); a failed upload leaves the reservation in AWAITING_UPLOAD for you to resume using the returned checkpoint. `resume` retries the existing reservation without creating another asset.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "description": "Path relative to MCP_FACTORY_MEDIA_ROOT.",
            "minLength": 1,
            "type": "string"
          },
          "fileName": {
            "description": "Name shown in App Store Connect (default: the file's name).",
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "appScreenshot",
              "appPreview",
              "appStoreReviewAttachment",
              "appEncryptionDeclarationDocument",
              "subscriptionAppStoreReviewScreenshot",
              "inAppPurchaseAppStoreReviewScreenshot"
            ],
            "type": "string"
          },
          "mimeType": {
            "description": "appPreview only, e.g. video/mp4.",
            "type": "string"
          },
          "parentId": {
            "description": "ID of the set/detail/subscription/IAP/declaration that owns the asset.",
            "minLength": 1,
            "type": "string"
          },
          "previewFrameTimeCode": {
            "description": "appPreview only: poster frame, e.g. 00:00:05:00.",
            "type": "string"
          },
          "resume": {
            "additionalProperties": false,
            "properties": {
              "assetId": {
                "minLength": 1,
                "type": "string"
              },
              "committed": {
                "type": "boolean"
              },
              "completedRanges": {
                "items": {
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array",
                "uniqueItems": true
              },
              "file": {
                "type": "string"
              },
              "fileName": {
                "type": "string"
              },
              "fileSize": {
                "maximum": 2147483648,
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "type": "string"
              },
              "parentId": {
                "type": "string"
              },
              "pendingRanges": {
                "items": {
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "ranges": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "length": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "offset": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "offset",
                    "length"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "sourceFileChecksum": {
                "pattern": "^[a-fA-F0-9]{32}$",
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            },
            "required": [
              "assetId",
              "fileSize",
              "sourceFileChecksum",
              "completedRanges"
            ],
            "type": "object"
          },
          "waitSeconds": {
            "description": "How long to wait for processing (default 120; 0 returns right after commit).",
            "maximum": 600,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "parentId",
          "file"
        ],
        "type": "object"
      },
      "annotations": {
        "title": "Upload App Store Connect asset",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
