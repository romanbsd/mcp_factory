use mcp_factory_core::ResourceSpec;

pub fn build_resources() -> Vec<ResourceSpec> {
    vec![
{% for resource in resources %}
        ResourceSpec {
            uri: {{ resource.uri | rust_string }}.to_string(),
            name: {{ resource.name | rust_string }}.to_string(),
            description: {{ resource.description | rust_string }}.to_string(),
            mime_type: {{ resource.mime_type | rust_string }}.to_string(),
            content: {{ resource.content | rust_string }},
        },
{% endfor %}
    ]
}
